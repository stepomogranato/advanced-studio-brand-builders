{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advanced-studio-brand-builders",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "assets": {
    "directory": "dist/client",
  },
  "r2_buckets": [
    {
      "binding": "TRADE_ASSETS",
      "bucket_name": "advanced-studio-trade-assets",
    },
  ],
  "d1_databases": [
    {
      "binding": "TRADE_ANALYTICS",
      "database_name": "advanced-studio-trade-analytics",
      "database_id": "e36e7ab5-c18f-41fd-b667-caec4ad82f53",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
